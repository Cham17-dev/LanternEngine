index 0000000..d8fb667
--- /dev/null
+++ b/gpu/shadps4/video_core/host_shaders/hdr/bb_display_copy.frag
@@ -0,0 +1,63 @@
+// SPDX-FileCopyrightText: Copyright 2026 bbport
+// SPDX-License-Identifier: GPL-2.0-or-later
+//
+// bbport HDR, mode 5 (the 16-bit chain, docs/HDR.md): replaces the game's display copy
+// (38d65b32), which copies its finished image into the display buffer through its brightness
+// curve (a 1D table per channel). The table covers 0..1; above the game's white the value goes on
+// as the table's value at white times the input (still in the chain's gamma encoding: the final
+// pass decodes it, post_process.frag native16_nits). The names are the recompiled shader's: vk_hdr_channel.cpp
+// copies its bindings and locations onto these.
+
+#version 450
+#extension GL_EXT_samplerless_texture_functions : require
+
+// The recompiler's push constants (shader_recompiler/resource.h, PushData) at the C++ struct's
+// offsets (checked in vk_rasterizer.cpp); bb_hdr is bbport's, set per draw (vk_rasterizer.cpp).
+layout(push_constant, std430) uniform AuxData {
+    layout(offset = 0) float xoffset;
+    layout(offset = 4) float yoffset;
+    layout(offset = 8) float xscale;
+    layout(offset = 12) float yscale;
+    layout(offset = 80) uvec4 buf_offsets0;
+    layout(offset = 96) uvec4 buf_offsets1;
+    layout(offset = 112) uvec2 buf_offsets2;
+    layout(offset = 120) uint motion_param;
+    layout(offset = 124) uint scene_size;
+    layout(offset = 128) uvec4 bb_hdr;
+} push_data;
+
+layout(set = 0, binding = 0) uniform texture2D fs_img0;
+// The brightness table (one row per channel): a 1D array image. Lantern's recompiler keeps 1D
+// image types (shadPS4 0.20.1, bbport's, binds it as a 2D array view instead): a 2D array
+// declaration read 0 here and the whole frame was black.
+layout(set = 0, binding = 1) uniform texture1DArray fs_img1;
+layout(set = 0, binding = 2) uniform sampler fs_samp0;
+
+layout(location = 0) out vec4 frag_color0;
+
+float table(float v, float row) {
+    if (v <= 1.0) {
+        return texture(sampler1DArray(fs_img1, fs_samp0), vec2(v, row)).x;
+    }
+    return texture(sampler1DArray(fs_img1, fs_samp0), vec2(1.0, row)).x * v;
+}
+
+// Below 0 (PsychoV30 with a BT.2020 target: a channel of a color outside BT.709), the curve
+// continued point-symmetric about its value at 0: the table alone read its value at 0 there and
+// the channel lost its sign.
+float brightness(float v, float row) {
+    return v >= 0.0 ? table(v, row) : 2.0 * table(0.0, row) - table(-v, row);
+}
+
+void main() {
+    uint w = push_data.scene_size & 65535u;
+    uint h = push_data.scene_size >> 16u;
+    vec2 scale = vec2(1920.0 / float(w == 0u ? 1920u : w), 1080.0 / float(h == 0u ? 1080u : h));
+    vec4 v = texelFetch(fs_img0, ivec2(floor(gl_FragCoord.xy * scale)), 0);
+    frag_color0 = vec4(brightness(v.z, 2.0), brightness(v.y, 1.0), brightness(v.x, 0.0), v.w);
+    // Chain probe (in-game menu, test; bb_hdr.z): 2 magenta where the finished image is above
+    // the game's white.
+    if (push_data.bb_hdr.z == 2u && max(max(v.x, v.y), v.z) > 1.001) {
+        frag_color0 = vec4(1.0, 0.0, 1.0, v.w);
+    }
+}
diff --git a/gpu/shadps4/video_core/host_shaders/hdr/bb_glow_source.frag b/gpu/shadps4/video_core/host_shaders/hdr/bb_glow_source.frag
new file mode 100644
index 0000000..b9baee6
--- /dev/null
+++ b/gpu/shadps4/video_core/host_shaders/hdr/bb_glow_source.frag
@@ -0,0 +1,29 @@
+// SPDX-FileCopyrightText: Copyright 2026 bbport
+// SPDX-License-Identifier: GPL-2.0-or-later
+//
+// bbport HDR, mode 5 (the 16-bit chain, docs/HDR.md): replaces the game's EmissiveToGlowPS
+// (57f3b8c2), a copy of the finished image into the glow's source. The copy is clamped to the
+// game's white, so the glow (added back over the image after the tone mapping) stays as the
+// game draws it while the image itself carries HDR light. The names are the recompiled
+// shader's: vk_hdr_channel.cpp copies its bindings and locations onto these.
+
+#version 450
+#extension GL_EXT_fragment_shader_barycentric : require
+
+layout(set = 0, binding = 0) uniform texture2D fs_img0;
+layout(set = 0, binding = 1) uniform sampler fs_samp0;
+
+layout(location = 0) pervertexEXT in vec4 fs_in_attr0_p[3];
+layout(location = 0) out vec4 frag_color0;
+
+void main() {
+    precise float dx1 = fs_in_attr0_p[1].x - fs_in_attr0_p[0].x;
+    precise float dx2 = fs_in_attr0_p[2].x - fs_in_attr0_p[0].x;
+    precise float dy1 = fs_in_attr0_p[1].y - fs_in_attr0_p[0].y;
+    precise float dy2 = fs_in_attr0_p[2].y - fs_in_attr0_p[0].y;
+    vec2 uv = vec2(fma(dx2, gl_BaryCoordEXT.z, fma(dx1, gl_BaryCoordEXT.y, fs_in_attr0_p[0].x)),
+                   fma(dy2, gl_BaryCoordEXT.z, fma(dy1, gl_BaryCoordEXT.y, fs_in_attr0_p[0].y)));
+    vec4 c = textureLod(sampler2D(fs_img0, fs_samp0), uv, 0.0);
+    // The game's channel order: its target holds them swapped.
+    frag_color0 = vec4(min(c.zyx, vec3(1.0)), c.w);
+}
diff --git a/gpu/shadps4/video_core/host_shaders/hdr/bb_tonemap.frag b/gpu/shadps4/video_core/host_shaders/hdr/bb_tonemap.frag
new file mode 100644
index 0000000..a9722f7
--- /dev/null
+++ b/gpu/shadps4/video_core/host_shaders/hdr/bb_tonemap.frag
@@ -0,0 +1,117 @@
+// SPDX-FileCopyrightText: Copyright 2026 bbport
+// SPDX-License-Identifier: GPL-2.0-or-later
+//
+// bbport HDR: replacement for Bloodborne's tonemap pixel shader (guest ps 0x5c02eaf8, first draw of
+// the pass that writes the 1920x1080 UI target). Its interface (inputs, descriptor bindings, push
+// constants) is the one bbport's recompiler gives the original, so the pipeline layout is
+// unchanged; the C++ side only substitutes it when the original's SPIR-V is the expected one.
+//
+// The game's math, as recovered from the original:
+//   x     = exposure tint from img0 (1x1), neutralized by the constants (x = 1)
+//   v     = x * scene * c[616]                          scene = img1 (HDR, RGBA16F)
+//   T     = y * (c[833] * (y - 1) + 1)^2, y = 1 - exp(-max(v, 2^-14) * c[832])
+//   U     = clamp(c[617] * (bloom * x + B))             bloom = img2, B: second neutralized path
+//   S     = T + U - T * U                               (screen blend)
+//   out   = pow(M * S, c[808]) + c[809] * grain + c[810]   M = 3x4 matrix c[840..851], BGR order
+//   alpha = clamp(dot(c[620..623], scene))
+//
+// Specialization constant 0 (mode): 0 = the game's tonemap, 1 = the same with the left half of the
+// screen tinted (to check that the replacement is active).
+
+#version 450
+#extension GL_EXT_fragment_shader_barycentric : require
+
+layout(constant_id = 0) const int BB_TONEMAP_MODE = 0;
+
+layout(set = 0, binding = 0, std430) readonly buffer ssbo_1 {
+    uint data[];
+} ssbo_1_1;
+
+// The recompiler's push constants (shader_recompiler/resource.h, PushData) at the C++ struct's
+// offsets (checked in vk_rasterizer.cpp); bb_hdr is bbport's, set per draw (vk_rasterizer.cpp).
+layout(push_constant, std430) uniform AuxData {
+    layout(offset = 0) float xoffset;
+    layout(offset = 4) float yoffset;
+    layout(offset = 8) float xscale;
+    layout(offset = 12) float yscale;
+    layout(offset = 80) uvec4 buf_offsets0;
+    layout(offset = 96) uvec4 buf_offsets1;
+    layout(offset = 112) uvec2 buf_offsets2;
+    layout(offset = 120) uint motion_param;
+    layout(offset = 124) uint scene_size;
+    layout(offset = 128) uvec4 bb_hdr;
+} push_data;
+
+layout(set = 0, binding = 1) uniform texture2D fs_img0; // exposure tint, 1x1
+layout(set = 0, binding = 2) uniform texture2D fs_img1; // scene, HDR
+layout(set = 0, binding = 3) uniform texture2D fs_img2; // bloom
+layout(set = 0, binding = 4) uniform texture2D fs_img3; // grain, 4x4
+layout(set = 0, binding = 5) uniform sampler fs_samp0;
+layout(set = 0, binding = 6) uniform sampler fs_samp1;
+layout(set = 0, binding = 7) uniform sampler fs_samp2;
+layout(set = 0, binding = 8) uniform sampler fs_samp3;
+
+layout(location = 0) pervertexEXT in vec4 fs_in_attr0_p[3];
+layout(location = 1) pervertexEXT in vec4 fs_in_attr1_p[3];
+layout(location = 3) pervertexEXT in vec4 fs_in_attr2_p[3];
+layout(location = 4) pervertexEXT in vec4 fs_in_attr3_p[3];
+layout(location = 0) out vec4 frag_color0;
+
+uint buf_off;
+
+float c(uint i) {
+    return uintBitsToFloat(ssbo_1_1.data[i + buf_off]);
+}
+
+// The game's texture coordinates: attribute interpolated with the barycentrics, as recompiled.
+vec2 interp(vec4 a0, vec4 a1, vec4 a2) {
+    vec3 b = gl_BaryCoordEXT;
+    return vec2(fma(a2.x - a0.x, b.z, fma(a1.x - a0.x, b.y, a0.x)),
+                fma(a2.y - a0.y, b.z, fma(a1.y - a0.y, b.y, a0.y)));
+}
+
+// Scale and bias, then saturation around the mean of the three channels.
+vec3 tint(vec3 t, uint scale, uint bias, uint saturation) {
+    vec3 s = t * c(scale) + c(bias);
+    float mean = (s.r + s.g + s.b) * 0.3333333432674407958984375;
+    return c(saturation) * (s - mean) + mean;
+}
+
+void main() {
+    buf_off = bitfieldExtract(push_data.buf_offsets0.x, 0, 8) >> 2u;
+
+    vec3 exposure = texture(sampler2D(fs_img0, fs_samp0),
+                            interp(fs_in_attr2_p[0], fs_in_attr2_p[1], fs_in_attr2_p[2])).rgb;
+    vec4 scene = textureLod(sampler2D(fs_img1, fs_samp1),
+                            interp(fs_in_attr0_p[0], fs_in_attr0_p[1], fs_in_attr0_p[2]), 0.0);
+    vec3 bloom = textureLod(sampler2D(fs_img2, fs_samp2),
+                            interp(fs_in_attr1_p[0], fs_in_attr1_p[1], fs_in_attr1_p[2]), 0.0).rgb;
+    float grain = textureLod(sampler2D(fs_img3, fs_samp3),
+                             interp(fs_in_attr3_p[0], fs_in_attr3_p[1], fs_in_attr3_p[2]), 0.0).x;
+
+    vec3 x = tint(exposure, 752u, 753u, 756u) * c(754u) + c(755u);
+    vec3 b = clamp(tint(exposure, 744u, 745u, 748u), 0.0, 1.0) * c(746u) + c(747u);
+
+    vec3 v = x * (scene.rgb * c(616u));
+    vec3 y = 1.0 - exp2(1.44269502162933349609375 * (-max(vec3(6.103515625e-05), v) * c(832u)));
+    vec3 knee = c(833u) * (y - 1.0) + 1.0;
+    vec3 tonemapped = clamp(knee * (y * knee), 0.0, 1.0);
+
+    vec3 glow = clamp(c(617u) * (bloom * x + b), 0.0, 1.0);
+    vec3 screen = tonemapped + glow - tonemapped * glow;
+
+    // Color matrix (rows 840, 844, 848 applied to RGB); the game writes the rows out in reverse
+    // order (row 848 to the first channel).
+    vec3 graded = vec3(dot(vec3(c(848u), c(849u), c(850u)), screen) + c(851u),
+                       dot(vec3(c(844u), c(845u), c(846u)), screen) + c(847u),
+                       dot(vec3(c(840u), c(841u), c(842u)), screen) + c(843u));
+    vec3 encoded = exp2(c(808u) * log2(clamp(graded + 2.384185791015625e-07, 0.0, 1.0)));
+    vec3 color = c(809u) * grain + encoded + c(810u);
+
+    if (BB_TONEMAP_MODE == 1 && gl_FragCoord.x < 960.0) {
+        color *= vec3(1.0, 0.6, 1.0); // check: magenta tint on the left half
+    }
+
+    frag_color0 = vec4(color,
+                       clamp(dot(vec4(c(620u), c(621u), c(622u), c(623u)), scene), 0.0, 1.0));
+}
diff --git a/gpu/shadps4/video_core/host_shaders/hdr/bb_tonemap_hdr.frag b/gpu/shadps4/video_core/host_shaders/hdr/bb_tonemap_hdr.frag
new file mode 100644
index 0000000..0d37153
--- /dev/null
+++ b/gpu/shadps4/video_core/host_shaders/hdr/bb_tonemap_hdr.frag
@@ -0,0 +1,169 @@
+// SPDX-FileCopyrightText: Copyright 2026 bbport
+// SPDX-License-Identifier: GPL-2.0-or-later
+//
+// bbport HDR: HDR version of Bloodborne's tonemap pixel shader (guest ps 0x5c02eaf8), for the HDR
+// side channel: the tonemap draw is replayed with this shader into a bbport-owned RGBA16F target
+// (docs/HDR.md, step 3b). Same interface and same math as hdr/bb_tonemap.frag, except the curve: Its interface (inputs, descriptor bindings, push
+// constants) is the one bbport's recompiler gives the original, so the pipeline layout is
+// unchanged; the C++ side only substitutes it when the original's SPIR-V is the expected one.
+//
+// The game's math, as recovered from the original:
+//   x     = exposure tint from img0 (1x1), neutralized by the constants (x = 1)
+//   v     = x * scene * c[616]                          scene = img1 (HDR, RGBA16F)
+//   T     = y * (c[833] * (y - 1) + 1)^2, y = 1 - exp(-max(v, 2^-14) * c[832])
+//   U     = clamp(c[617] * (bloom * x + B))             bloom = img2, B: second neutralized path
+//   S     = T + U - T * U                               (screen blend)
+//   out   = pow(M * S, c[808]) + c[809] * grain + c[810]   M = 3x4 matrix c[840..851], BGR order
+//   alpha = clamp(dot(c[620..623], scene))
+//
+
+#version 450
+#extension GL_EXT_fragment_shader_barycentric : require
+
+//   - up to the knee (the game's output at BB_HDR_KNEE of white) the game's curve, unchanged;
+//   - above, a Neutwo shoulder (hdr/renodx.glsl) with the same slope at the knee, rising to
+//     BB_HDR_PEAK (peak luminance / paper white) instead of the game's white.
+// Output (RGBA16F):
+//   r, b, a = HDR gain of the red, green and blue channels, all the same here: luminance of the
+//       HDR color / luminance of the game's color (1 below the knee);
+//   g = luminance of the game's own output (gamma 2.2 encoded, no grain), so the final pass can
+//       tell the scene from the UI drawn over it.
+// The final pass multiplies the game's finished image (UI, AA, grain and brightness setting
+// included) by the gain where the pixel is still the scene: the SDR image is kept as it is and
+// only its highlights are raised, so the channel order of the targets does not matter.
+// Specialization constants: 1 = BB_HDR_PEAK, 2 = BB_HDR_KNEE.
+
+layout(constant_id = 1) const float BB_HDR_PEAK = 4.926;
+layout(constant_id = 2) const float BB_HDR_KNEE = 0.6;
+
+layout(set = 0, binding = 0, std430) readonly buffer ssbo_1 {
+    uint data[];
+} ssbo_1_1;
+
+// The recompiler's push constants (shader_recompiler/resource.h, PushData) at the C++ struct's
+// offsets (checked in vk_rasterizer.cpp); bb_hdr is bbport's, set per draw (vk_rasterizer.cpp).
+layout(push_constant, std430) uniform AuxData {
+    layout(offset = 0) float xoffset;
+    layout(offset = 4) float yoffset;
+    layout(offset = 8) float xscale;
+    layout(offset = 12) float yscale;
+    layout(offset = 80) uvec4 buf_offsets0;
+    layout(offset = 96) uvec4 buf_offsets1;
+    layout(offset = 112) uvec2 buf_offsets2;
+    layout(offset = 120) uint motion_param;
+    layout(offset = 124) uint scene_size;
+    layout(offset = 128) uvec4 bb_hdr;
+} push_data;
+
+layout(set = 0, binding = 1) uniform texture2D fs_img0; // exposure tint, 1x1
+layout(set = 0, binding = 2) uniform texture2D fs_img1; // scene, HDR
+layout(set = 0, binding = 3) uniform texture2D fs_img2; // bloom
+layout(set = 0, binding = 4) uniform texture2D fs_img3; // grain, 4x4
+layout(set = 0, binding = 5) uniform sampler fs_samp0;
+layout(set = 0, binding = 6) uniform sampler fs_samp1;
+layout(set = 0, binding = 7) uniform sampler fs_samp2;
+layout(set = 0, binding = 8) uniform sampler fs_samp3;
+
+layout(location = 0) pervertexEXT in vec4 fs_in_attr0_p[3];
+layout(location = 1) pervertexEXT in vec4 fs_in_attr1_p[3];
+layout(location = 3) pervertexEXT in vec4 fs_in_attr2_p[3];
+layout(location = 4) pervertexEXT in vec4 fs_in_attr3_p[3];
+layout(location = 0) out vec4 frag_color0;
+layout(location = 1) out vec4 frag_aux; // effect ratios (bb_composite_hdr.frag): none here
+
+uint buf_off;
+
+float c(uint i) {
+    return uintBitsToFloat(ssbo_1_1.data[i + buf_off]);
+}
+
+// The game's texture coordinates: attribute interpolated with the barycentrics, as recompiled.
+vec2 interp(vec4 a0, vec4 a1, vec4 a2) {
+    vec3 b = gl_BaryCoordEXT;
+    return vec2(fma(a2.x - a0.x, b.z, fma(a1.x - a0.x, b.y, a0.x)),
+                fma(a2.y - a0.y, b.z, fma(a1.y - a0.y, b.y, a0.y)));
+}
+
+// Scale and bias, then saturation around the mean of the three channels.
+vec3 tint(vec3 t, uint scale, uint bias, uint saturation) {
+    vec3 s = t * c(scale) + c(bias);
+    float mean = (s.r + s.g + s.b) * 0.3333333432674407958984375;
+    return c(saturation) * (s - mean) + mean;
+}
+
+// rows dot color, for the game's 3x4 color matrix (mat3 columns hold the rows here).
+vec3 screen_rows(mat3 rows, vec3 color) {
+    return vec3(dot(rows[0], color), dot(rows[1], color), dot(rows[2], color));
+}
+
+// The game's curve: y = 1 - exp(-k v), T = y (c (y - 1) + 1)^2.
+vec3 game_curve(vec3 v, float k, float knee_c) {
+    vec3 y = 1.0 - exp2(1.44269502162933349609375 * (-max(vec3(6.103515625e-05), v) * k));
+    vec3 knee = knee_c * (y - 1.0) + 1.0;
+    return clamp(knee * (y * knee), 0.0, 1.0);
+}
+
+// Where the game's curve reaches `target` (< 1): the scene value and the slope there (Newton on y).
+void game_curve_point(float target, float k, float knee_c, out float v, out float slope) {
+    float y = target;
+    for (int i = 0; i < 8; ++i) {
+        float a = knee_c * y - knee_c + 1.0;
+        y -= (y * a * a - target) / (a * a + 2.0 * knee_c * y * a);
+    }
+    y = clamp(y, 0.0, 0.999999);
+    float a = knee_c * y - knee_c + 1.0;
+    v = -log(1.0 - y) / k;
+    slope = (a * a + 2.0 * knee_c * y * a) * k * (1.0 - y);
+}
+
+// Neutwo with peak p: p x / sqrt(x^2 + p^2) (slope 1 at 0, tends to p).
+vec3 neutwo(vec3 x, float p) {
+    return p * x * inversesqrt(x * x + p * p);
+}
+
+void main() {
+    buf_off = bitfieldExtract(push_data.buf_offsets0.x, 0, 8) >> 2u;
+
+    vec3 exposure = texture(sampler2D(fs_img0, fs_samp0),
+                            interp(fs_in_attr2_p[0], fs_in_attr2_p[1], fs_in_attr2_p[2])).rgb;
+    vec4 scene = textureLod(sampler2D(fs_img1, fs_samp1),
+                            interp(fs_in_attr0_p[0], fs_in_attr0_p[1], fs_in_attr0_p[2]), 0.0);
+    vec3 bloom = textureLod(sampler2D(fs_img2, fs_samp2),
+                            interp(fs_in_attr1_p[0], fs_in_attr1_p[1], fs_in_attr1_p[2]), 0.0).rgb;
+
+    vec3 x = tint(exposure, 752u, 753u, 756u) * c(754u) + c(755u);
+    vec3 b = clamp(tint(exposure, 744u, 745u, 748u), 0.0, 1.0) * c(746u) + c(747u);
+    vec3 glow = clamp(c(617u) * (bloom * x + b), 0.0, 1.0);
+
+    float k = c(832u), knee_c = c(833u);
+    vec3 v = x * (scene.rgb * c(616u));
+    vec3 sdr = game_curve(v, k, knee_c);
+
+    // HDR curve: the game's below the knee, a Neutwo shoulder above.
+    float knee_v, knee_slope;
+    game_curve_point(BB_HDR_KNEE, k, knee_c, knee_v, knee_slope);
+    vec3 shoulder = BB_HDR_KNEE + neutwo(max(v - knee_v, 0.0) * knee_slope,
+                                         max(BB_HDR_PEAK - BB_HDR_KNEE, 1e-3));
+    vec3 hdr = mix(sdr, shoulder, step(knee_v, v));
+
+    // Screen blend of the bloom on the SDR part only (above 1 it would subtract).
+    vec3 sdr_screen = sdr + glow - sdr * glow;
+    vec3 hdr_screen = hdr + glow * (1.0 - min(hdr, 1.0));
+
+    mat3 grade_rows = mat3(vec3(c(840u), c(841u), c(842u)), vec3(c(844u), c(845u), c(846u)),
+                           vec3(c(848u), c(849u), c(850u)));
+    vec3 offsets = vec3(c(843u), c(847u), c(851u));
+    // The game writes row 848 to the first channel (see hdr/bb_tonemap.frag).
+    vec3 sdr_graded = (screen_rows(grade_rows, sdr_screen) + offsets).zyx;
+    vec3 hdr_graded = (screen_rows(grade_rows, hdr_screen) + offsets).zyx;
+
+    // The game's channel order here is BGR (row 840, mostly red, goes to the third channel).
+    const vec3 luma_bgr = vec3(0.0721923154, 0.7151686788, 0.2126390059);
+    vec3 sdr_encoded = exp2(c(808u) * log2(clamp(sdr_graded + 2.384185791015625e-07, 0.0, 1.0)));
+    float sdr_luma = dot(max(sdr_graded, 0.0), luma_bgr);
+    float hdr_luma = dot(max(hdr_graded, 0.0), luma_bgr);
+    float gain = sdr_luma > 1e-4 ? max(hdr_luma / sdr_luma, 1.0) : 1.0;
+    // r, b, a: the gain of each channel (the same here), g: the reference luminance.
+    frag_color0 = vec4(gain, dot(sdr_encoded, luma_bgr), gain, gain);
+    frag_aux = vec4(1.0);
+}
diff --git a/gpu/shadps4/video_core/host_shaders/hdr/gamut_bridge.glsl b/gpu/shadps4/video_core/host_shaders/hdr/gamut_bridge.glsl
new file mode 100644
index 0000000..918d58f
--- /dev/null
+++ b/gpu/shadps4/video_core/host_shaders/hdr/gamut_bridge.glsl
@@ -0,0 +1,200 @@
+// SPDX-FileCopyrightText: Copyright (C) 2026 Carlos Lopez (RenoDX), bbport
+// SPDX-License-Identifier: MIT
+//
+// bbport: GLSL port of RenoDX's AdaptiveD65 BT.709 gamut compression (https://github.com/
+// clshortfuse/renodx, src/shaders/color/gamut.hlsl and macleod_boynton.hlsl, MIT) and of Neutwo's
+// max-channel scale (tonemap/neutwo.hlsl), the pieces of RenoDX's SDR LUT bridge
+// (.agents/skills/handle-sdr-tonemap-lut/snippets/sdr_lut_bridge.hlsl): colors outside BT.709 are
+// brought inside it along the line to white in MacLeod-Boynton chromaticity (CIE 170-2
+// weights, Stockman-Sharpe LMS relative to D65 white), then the same line taken back out after
+// the LUT. Strength 1, not compressing in-gamut colors, as the snippet calls them. The constants
+// are RenoDX's matrices multiplied out in double precision (docs/hdr-tools/gamut_bridge_check).
+
+#ifndef BBPORT_GAMUT_BRIDGE_GLSL
+#define BBPORT_GAMUT_BRIDGE_GLSL
+
+const vec3 BB_GM_BT709_TO_LMS[3] = vec3[3](  // rows
+    vec3(0.2896057766, 0.6972466442, 0.07637127862),
+    vec3(0.09018375762, 0.7073490257, 0.1122031464),
+    vec3(0.01552874012, 0.05360930731, 0.5097978305));
+const vec3 BB_GM_LMS_TO_BT709[3] = vec3[3](  // rows
+    vec3(4.96761965, -4.922379529, 0.3391991812),
+    vec3(-0.6196828788, 2.051750652, -0.3587439844),
+    vec3(-0.08615200402, -0.065819383, 1.988954483));
+const vec3 BB_GM_WEIGHTS = vec3(0.68990272, 0.34832189, 0.03715970692);
+const vec3 BB_GM_ADAPTIVE_LMS = vec3(1.063223699, 0.9097359297, 0.5789358779); // LMS of BT.709 (1, 1, 1)
+const vec2 BB_GM_WHITE = vec2(0.6983281224, 0.02047613467);                    // D65 in MB
+// The BT.709 primaries in adaptive-relative weighted MB.
+const vec2 BB_GM_BOUND_R = vec2(0.8447741838, 0.004480724501);
+const vec2 BB_GM_BOUND_G = vec2(0.6255404359, 0.004757598166);
+const vec2 BB_GM_BOUND_B = vec2(0.5356426431, 0.3536890971);
+
+const float BB_GM_EPSILON = 1e-20;
+const float BB_GM_NEAR_WHITE = 1e-14;
+const float BB_GM_RAY_T_MAX = 1e20;
+const float BB_GM_INTERVAL_MAX = 3.402823466e38;
+const vec2 BB_GM_CIE_NORMALS[7] = vec2[7](
+    vec2(-0.043889, -0.006807), vec2(-0.007821, -0.008564), vec2(-0.000604, -0.007942),
+    vec2(0.0, -0.080835), vec2(0.953597, 0.307020), vec2(-0.060969, 0.019752),
+    vec2(-0.106895, 0.004035));
+const float BB_GM_CIE_NUMERATORS[7] = float[7](
+    0.0065035249, 0.00104900495, 0.000207697044, 0.00165556648, 0.252472349, 0.0241967351,
+    0.0199621232);
+
+vec3 bb_gm_rows(const vec3 m[3], vec3 v) {
+    return vec3(dot(m[0], v), dot(m[1], v), dot(m[2], v));
+}
+
+// macleod_boynton::from::WeightedLMS: (l, s, l + m).
+vec3 bb_gm_mb(vec3 w) {
+    float y = max(w.x + w.y, 0.0);
+    float inv = y == 0.0 ? 0.0 : 1.0 / y;
+    return vec3(w.x * inv, w.z * inv, y);
+}
+
+vec3 bb_gm_weighted(vec2 ls, float y) {
+    return vec3(ls.x, 1.0 - ls.x, ls.y) * y;
+}
+
+// RayExitTCIE1702D: from white along `direction` to the CIE 170-2 locus (its 7 half-spaces).
+float bb_gm_ray_exit_cie(vec2 direction) {
+    if (dot(direction, direction) <= BB_GM_NEAR_WHITE) {
+        return BB_GM_RAY_T_MAX;
+    }
+    float t_best = BB_GM_RAY_T_MAX;
+    bool hit_any = false;
+    for (int i = 0; i < 7; ++i) {
+        float denom = dot(BB_GM_CIE_NORMALS[i], direction);
+        float t = denom > 1e-8 ? BB_GM_CIE_NUMERATORS[i] / denom : BB_GM_RAY_T_MAX;
+        t_best = min(t_best, t);
+        hit_any = hit_any || denom > 1e-8;
+    }
+    return hit_any ? max(t_best, 0.0) : BB_GM_RAY_T_MAX;
+}
+
+float bb_gm_cross(vec2 a, vec2 b) {
+    return a.x * b.y - a.y * b.x;
+}
+
+bool bb_gm_segment_hit(vec2 origin, vec2 direction, vec2 a, vec2 b, out float t_hit) {
+    t_hit = 0.0;
+    vec2 edge = b - a;
+    float denom = bb_gm_cross(direction, edge);
+    if (abs(denom) <= BB_GM_EPSILON) return false;
+    vec2 a_origin = a - origin;
+    float t = bb_gm_cross(a_origin, edge) / denom;
+    float u = bb_gm_cross(a_origin, direction) / denom;
+    if (t < 0.0 || u < 0.0 || u > 1.0) return false;
+    t_hit = t;
+    return true;
+}
+
+// RayMaxT_RGBTriangleInMB: from white along `direction` to the BT.709 triangle.
+float bb_gm_ray_triangle(vec2 direction, out bool has_solution) {
+    has_solution = false;
+    if (dot(direction, direction) <= BB_GM_NEAR_WHITE) return 0.0;
+    float t_best = BB_GM_INTERVAL_MAX, t_hit;
+    bool hit_any = false;
+    if (bb_gm_segment_hit(BB_GM_WHITE, direction, BB_GM_BOUND_R, BB_GM_BOUND_G, t_hit)) {
+        t_best = min(t_best, t_hit);
+        hit_any = true;
+    }
+    if (bb_gm_segment_hit(BB_GM_WHITE, direction, BB_GM_BOUND_G, BB_GM_BOUND_B, t_hit)) {
+        t_best = min(t_best, t_hit);
+        hit_any = true;
+    }
+    if (bb_gm_segment_hit(BB_GM_WHITE, direction, BB_GM_BOUND_B, BB_GM_BOUND_R, t_hit)) {
+        t_best = min(t_best, t_hit);
+        hit_any = true;
+    }
+    has_solution = hit_any;
+    return hit_any ? max(t_best, 0.0) : 0.0;
+}
+
+// ClampWeightedLMSToCIE1702 (purity 1).
+vec3 bb_gm_clamp_cie(vec3 w) {
+    vec3 c = max(w, 0.0);
+    vec3 mb = bb_gm_mb(c);
+    if (!(mb.z > BB_GM_EPSILON)) return vec3(c.x, c.y, 0.0);
+    vec2 direction = mb.xy - BB_GM_WHITE;
+    if (dot(direction, direction) <= BB_GM_NEAR_WHITE) return c;
+    float t_final = min(1.0, bb_gm_ray_exit_cie(direction));
+    return bb_gm_weighted(BB_GM_WHITE + direction * t_final, mb.z);
+}
+
+// The adaptive-relative weighted LMS of a BT.709 color, and back.
+vec3 bb_gm_relative(vec3 bt709) {
+    vec3 w = BB_GM_WEIGHTS * bb_gm_rows(BB_GM_BT709_TO_LMS, bt709);
+    return vec3(BB_GM_ADAPTIVE_LMS.x == 0.0 ? 0.0 : w.x / BB_GM_ADAPTIVE_LMS.x,
+                BB_GM_ADAPTIVE_LMS.y == 0.0 ? 0.0 : w.y / BB_GM_ADAPTIVE_LMS.y,
+                BB_GM_ADAPTIVE_LMS.z == 0.0 ? 0.0 : w.z / BB_GM_ADAPTIVE_LMS.z);
+}
+
+vec3 bb_gm_bt709(vec3 relative) {
+    return bb_gm_rows(BB_GM_LMS_TO_BT709,
+                      relative * max(BB_GM_ADAPTIVE_LMS, vec3(1e-6)) / BB_GM_WEIGHTS);
+}
+
+// ComputeGamutCompressionScaleBT709AdaptiveD65(color, D65, strength 1): 1 inside BT.709, the
+// share of the line to white kept outside it.
+float bb_gamut_compression_scale(vec3 bt709) {
+    vec3 c = bb_gm_clamp_cie(max(bb_gm_relative(bt709), 0.0));
+    vec3 mb = bb_gm_mb(c);
+    if (!(mb.z > BB_GM_EPSILON)) return 1.0;
+    vec2 direction = mb.xy - BB_GM_WHITE;
+    if (dot(direction, direction) <= BB_GM_NEAR_WHITE) return 1.0;
+    bool has_peak;
+    float t_peak = bb_gm_ray_triangle(direction, has_peak);
+    float t_clip = bb_gm_ray_exit_cie(direction);
+    if (!has_peak) t_peak = t_clip;
+    float t_hard = clamp(t_peak, 0.0, 1.0);
+    // NeutwoScaleFromRayT(min(t_peak, t_clip), t_clip): Neutwo(1, peak, clip).
+    float peak = max(min(t_peak, t_clip), 0.0);
+    float clip = max(t_clip, peak);
+    float neutwo = clip * peak * inversesqrt(max((clip * clip - peak * peak) + clip * clip * peak * peak, 1e-20));
+    float t_soft = clamp(neutwo, 0.0, 1.0);
+    // SoftCompressionActivationFromRayT(t_peak, 0.08).
+    float outside = 1.0 - clamp(t_peak, 0.0, 1.0);
+    float soft_mix = outside / (outside + 0.08);
+    return mix(t_hard, t_soft, soft_mix);
+}
+
+// GamutCompressBT709AdaptiveD65.
+vec3 bb_gamut_compress(vec3 bt709, float scale) {
+    vec3 c = bb_gm_clamp_cie(max(bb_gm_relative(bt709), 0.0));
+    vec3 mb = bb_gm_mb(c);
+    vec3 out_rel;
+    if (!(mb.z > BB_GM_EPSILON)) {
+        out_rel = vec3(c.x, c.y, 0.0);
+    } else {
+        vec2 direction = mb.xy - BB_GM_WHITE;
+        out_rel = dot(direction, direction) <= BB_GM_NEAR_WHITE
+                      ? c
+                      : bb_gm_weighted(BB_GM_WHITE + clamp(scale, 0.0, 1.0) * direction, mb.z);
+    }
+    return bb_gm_bt709(out_rel);
+}
+
+// GamutDecompressBT709AdaptiveD65.
+vec3 bb_gamut_decompress(vec3 bt709, float scale) {
+    vec3 c = max(bb_gm_relative(bt709), 0.0);
+    vec3 mb = bb_gm_mb(c);
+    vec3 out_rel;
+    if (!(mb.z > BB_GM_EPSILON)) {
+        out_rel = vec3(c.x, c.y, 0.0);
+    } else {
+        vec2 direction = mb.xy - BB_GM_WHITE;
+        out_rel = dot(direction, direction) <= BB_GM_NEAR_WHITE
+                      ? c
+                      : bb_gm_weighted(BB_GM_WHITE + direction / max(scale, 1e-6), mb.z);
+    }
+    return bb_gm_bt709(out_rel);
+}
+
+// neutwo::ComputeMaxChannelScale: Neutwo (x / sqrt(1 + x^2)) of the largest channel over it.
+float bb_neutwo_max_channel_scale(vec3 color) {
+    float m = max(max(abs(color.r), abs(color.g)), abs(color.b));
+    return m != 0.0 ? (m * inversesqrt(m * m + 1.0)) / m : 1.0;
+}
+
+#endif
