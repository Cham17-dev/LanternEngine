+// code run by docs/hdr-tools/gcn_emu.py (1380 reproduced, largest difference 1.9e-02 on
+// a 0..1 output). Variants with standard = 0 (several scene samples: distortion effects, or not
+// reproduced within 0.02) are listed for the log only. Sorted by hash.
+
+#pragma once
+
+#include <array>
+
+#include "common/types.h"
+
