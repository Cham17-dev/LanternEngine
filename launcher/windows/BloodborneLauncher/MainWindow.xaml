<ui:FluentWindow x:Class="BloodborneLauncher.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
                 xmlns:views="clr-namespace:BloodborneLauncher.Views"
                 Title="Lantern Engine + PsychoV30"
                 Icon="app.ico"
                 Height="780" Width="1040"
                 MinHeight="560" MinWidth="820"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="None"
                 WindowCornerPreference="Round"
                 Background="{DynamicResource WindowBaseBrush}"
                 UseLayoutRounding="True"
                 SnapsToDevicePixels="True"
                 TextOptions.TextFormattingMode="Display"
                 TextOptions.TextRenderingMode="ClearType"
                 TextOptions.TextHintingMode="Fixed">
    <!--
        A slim title bar with traffic lights and a centred title, a source-list sidebar with
        small-caps group labels, the page, a folding activity log and a one-line status bar.
        SetWindowChrome gives the title bar a native caption height, so dragging, double-click
        maximise and Aero snap come from Windows; only the buttons opt back into hit-testing.
    -->

    <ui:FluentWindow.Resources>
        <Style x:Key="TrafficLight" TargetType="Button">
            <Setter Property="Width" Value="12" />
            <Setter Property="Height" Value="12" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Arrow" />
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse Fill="{TemplateBinding Background}" Stroke="#26000000" StrokeThickness="0.5" />
                            <Path x:Name="Glyph" Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                  Stroke="#99000000" StrokeThickness="1.1" Stretch="None" Opacity="0" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=StackPanel}}" Value="True">
                                <Setter TargetName="Glyph" Property="Opacity" Value="1" />
                            </DataTrigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.75" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TitleIcon" TargetType="Button">
            <Setter Property="Height" Value="22" />
            <Setter Property="MinWidth" Value="26" />
            <Setter Property="Focusable" Value="False" />
            <!-- WPF-UI's implicit button style paints a light fill; these sit on the dark title bar. -->
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="7,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SidebarItemHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidebarHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="9.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource SidebarHeaderBrush}" />
            <Setter Property="Margin" Value="18,0,0,6" />
        </Style>

        <Style x:Key="SidebarItem" TargetType="RadioButton">
            <Setter Property="GroupName" Value="Pages" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Margin" Value="8,1" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SidebarItemHoverBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SidebarItemSelectedBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidebarIcon" TargetType="ui:SymbolIcon">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Width" Value="16" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
        </Style>
        <!-- A top tab: a segment of the tab strip, filled when chosen. -->
        <Style x:Key="TabItem" TargetType="RadioButton">
            <Setter Property="GroupName" Value="Pages" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="16" Padding="18,6" MinWidth="80">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SidebarItemHoverBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SegmentSelectedBrush}" />
                                <Setter Property="Foreground" Value="White" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ui:FluentWindow.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="34" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.RowSpan="4" IsHitTestVisible="False" Background="{DynamicResource WindowBaseBrush}" ClipToBounds="True">
            <!-- Glass (Modern): the game's own artwork, blurred and darkened, behind the frosted panes. -->
            <Image x:Name="BackdropImage" Stretch="UniformToFill" Opacity="1" Margin="-60" Visibility="Collapsed"
                   RenderOptions.BitmapScalingMode="LowQuality">
                <Image.Effect>
                    <BlurEffect Radius="48" KernelType="Gaussian" RenderingBias="Performance" />
                </Image.Effect>
            </Image>
            <Rectangle x:Name="BackdropShade" Visibility="Collapsed">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#590A0B0E" Offset="0" />
                        <GradientStop Color="#800A0B0E" Offset="0.5" />
                        <GradientStop Color="#B30A0B0E" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
        </Grid>

        <!-- ==================== Title bar ==================== -->
        <Border Grid.Row="0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left"
                            Background="Transparent" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource TrafficLight}" Background="#FFFF5F57" ToolTip="Close"
                            Tag="M 3.5,3.5 L 8.5,8.5 M 8.5,3.5 L 3.5,8.5" Click="CloseWindow_Click" />
                    <Button Style="{StaticResource TrafficLight}" Background="#FFFEBC2E" ToolTip="Minimize"
                            Tag="M 3,6 L 9,6" Click="MinimizeWindow_Click" />
                    <Button Style="{StaticResource TrafficLight}" Background="#FF28C840" ToolTip="Maximize"
                            Tag="M 3,6 L 9,6 M 6,3 L 6,9" Click="MaximizeWindow_Click" />
                </StackPanel>

                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" IsHitTestVisible="False">
                    <Run Text="Lantern Engine + PsychoV30" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <Run x:Name="TitlePage" Text="" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                </TextBlock>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0">
                    <Button x:Name="TitleUpdate" Style="{StaticResource TitleIcon}" Click="TitleUpdate_Click" Margin="0,0,6,0"
                            Visibility="Collapsed" BorderBrush="{DynamicResource GoodTextBrush}" BorderThickness="1"
                            ToolTip="A new launcher version is available">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="13" Margin="0,0,5,0"
                                           Foreground="{DynamicResource GoodTextBrush}" />
                            <TextBlock x:Name="TitleUpdateText" Text="Update" FontSize="11.5" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="TitlePlay" Style="{StaticResource TitleIcon}" Click="TitlePlay_Click" Margin="0,0,6,0"
                            Background="{DynamicResource ControlFillColorSecondaryBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                            ToolTip="Start the game">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon x:Name="TitlePlayIcon" Symbol="Play24" FontSize="13" Margin="0,0,5,0"
                                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock x:Name="TitlePlayText" Text="Play" FontSize="11.5" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource TitleIcon}" Click="ToggleLog_Click" ToolTip="Activity">
                        <ui:SymbolIcon Symbol="Pulse24" FontSize="14"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== Tabs (Modern) or sidebar (Classic) + page ==================== -->
        <Grid Grid.Row="1" Background="{DynamicResource ContentAreaBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Classic: the source-list sidebar. -->
            <Border x:Name="Sidebar" Grid.Column="0" Grid.RowSpan="2" Width="196" Visibility="Collapsed"
                    Background="{DynamicResource WindowBaseBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,1,0">
                <DockPanel Margin="0,16,0,10">
                    <RadioButton DockPanel.Dock="Bottom" GroupName="Classic" Style="{StaticResource SidebarItem}"
                                 Tag="{x:Type views:SettingsPage}" Checked="SidebarItem_Checked">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Settings24" Style="{StaticResource SidebarIcon}" />
                            <TextBlock Text="Settings" />
                        </StackPanel>
                    </RadioButton>
                    <StackPanel>
                        <TextBlock Text="GAME" Style="{StaticResource SidebarHeader}" />
                        <RadioButton x:Name="ClassicPlay" GroupName="Classic" Style="{StaticResource SidebarItem}"
                                     Tag="{x:Type views:PlayPage}" Checked="SidebarItem_Checked">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Play24" Style="{StaticResource SidebarIcon}" />
                                <TextBlock Text="Play" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton GroupName="Classic" Style="{StaticResource SidebarItem}"
                                     Tag="{x:Type views:DisplayPage}" Checked="SidebarItem_Checked">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Desktop24" Style="{StaticResource SidebarIcon}" />
                                <TextBlock Text="Display" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton GroupName="Classic" Style="{StaticResource SidebarItem}"
                                     Tag="{x:Type views:GraphicsPage}" Checked="SidebarItem_Checked">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Sparkle24" Style="{StaticResource SidebarIcon}" />
                                <TextBlock Text="Graphics" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="ClassicControls" GroupName="Classic" Style="{StaticResource SidebarItem}"
                                     Tag="{x:Type views:ControlsPage}" Checked="SidebarItem_Checked">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="XboxController24" Style="{StaticResource SidebarIcon}" />
                                <TextBlock Text="Controls" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton GroupName="Classic" Style="{StaticResource SidebarItem}"
                                     Tag="{x:Type views:TrophiesPage}" Checked="SidebarItem_Checked">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Trophy24" Style="{StaticResource SidebarIcon}" />
                                <TextBlock Text="Trophies" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="ClassicMods" GroupName="Classic" Style="{StaticResource SidebarItem}"
                                     Tag="{x:Type views:ModsPage}" Checked="SidebarItem_Checked">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="PuzzlePiece24" Style="{StaticResource SidebarIcon}" />
                                <TextBlock Text="Mods &amp; patches" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="ClassicOnline" GroupName="Classic" Style="{StaticResource SidebarItem}"
                                     Tag="{x:Type views:OnlinePage}" Checked="SidebarItem_Checked">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Globe24" Style="{StaticResource SidebarIcon}" />
                                <TextBlock Text="Online" />
                            </StackPanel>
                        </RadioButton>
                        <TextBlock Text="SYSTEM" Style="{StaticResource SidebarHeader}" Margin="18,18,0,6" />
                        <RadioButton x:Name="ClassicOutput" GroupName="Classic" Style="{StaticResource SidebarItem}"
                                     Tag="{x:Type views:OutputPage}" Checked="SidebarItem_Checked">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="WindowConsole20" Style="{StaticResource SidebarIcon}" />
                                <TextBlock Text="Game output" />
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Modern: tabs across the top. -->
            <Border x:Name="TabStrip" Grid.Column="1" Grid.Row="0" HorizontalAlignment="Center" Margin="0,12,0,4" Padding="4" CornerRadius="20"
                    Background="{DynamicResource PillTrackBrush}" BorderBrush="{DynamicResource GlassPaneStrokeBrush}" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="PlayItem" Style="{StaticResource TabItem}" Content="Play"
                                 Tag="{x:Type views:PlayPage}" Checked="SidebarItem_Checked" />
                    <RadioButton Style="{StaticResource TabItem}" Content="Display"
                                 Tag="{x:Type views:DisplayPage}" Checked="SidebarItem_Checked" />
                    <RadioButton Style="{StaticResource TabItem}" Content="Graphics"
                                 Tag="{x:Type views:GraphicsPage}" Checked="SidebarItem_Checked" />
                    <RadioButton x:Name="ControlsItem" Style="{StaticResource TabItem}" Content="Controls"
                                 Tag="{x:Type views:ControlsPage}" Checked="SidebarItem_Checked" />
                    <RadioButton Style="{StaticResource TabItem}" Content="Trophies"
                                 Tag="{x:Type views:TrophiesPage}" Checked="SidebarItem_Checked" />
                    <RadioButton x:Name="MoreItem" Style="{StaticResource TabItem}" Content="More"
                                 Tag="{x:Type views:MorePage}" Checked="SidebarItem_Checked" />
                </StackPanel>
            </Border>

            <Frame x:Name="PageFrame" Grid.Column="1" Grid.Row="1" NavigationUIVisibility="Hidden"
                   JournalOwnership="OwnsJournal" Focusable="False" Background="Transparent"
                   Navigated="PageFrame_Navigated" />
        </Grid>

        <!-- ==================== Activity log (folded by default) ==================== -->
        <Border x:Name="LogPanel" Grid.Row="2" Height="140" Visibility="Collapsed"
                Background="{DynamicResource PanelDeepBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <Grid>
                <ScrollViewer x:Name="LogScroller" VerticalScrollBarVisibility="Auto" Padding="16,8,48,8">
                    <ItemsControl x:Name="LogList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Time}" FontFamily="{StaticResource MonoFont}" FontSize="11"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,0,10,0" />
                                    <TextBlock Grid.Column="1" Text="{Binding Message}" FontFamily="{StaticResource MonoFont}" FontSize="11.5"
                                               Foreground="{Binding Color}" TextWrapping="Wrap" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Button Style="{StaticResource TitleIcon}" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="0,6,14,0" Click="ClearLog_Click" ToolTip="Clear activity">
                    <ui:SymbolIcon Symbol="Broom24" FontSize="13"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </Button>
            </Grid>
        </Border>

        <!-- ==================== Status bar ==================== -->
        <Border Grid.Row="3" Height="24" Cursor="Hand" MouseLeftButtonUp="StatusBar_Click"
                Background="{DynamicResource PillTrackBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0"
                ToolTip="Show or hide activity">
            <Grid Margin="12,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusDot" Width="5" Height="5" VerticalAlignment="Center" Fill="{DynamicResource StatusDotIdleBrush}" />
                    <TextBlock x:Name="StatusText" Text="Ready" FontSize="10.5" Margin="8,0,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="620" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="SavedText" FontSize="10.5" Margin="0,0,12,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    <TextBlock x:Name="LogCount" FontSize="10.5" Margin="0,0,12,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    <TextBlock x:Name="VersionText" FontSize="10.5" VerticalAlignment="Center" FontFamily="{StaticResource MonoFont}"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
