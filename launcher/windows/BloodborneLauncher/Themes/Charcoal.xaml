<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Charcoal surfaces: neutral greys stepped a few shades apart (window, sidebar, content,
        card), hairline borders, and one accent for anything interactive. Everything overrides
        WPF-UI's brush tokens rather than its templates, so every control recolours as one.
    -->

    <!-- ==================== Window ==================== -->
    <SolidColorBrush x:Key="WindowBaseBrush" Color="#FF242426" />
    <SolidColorBrush x:Key="ContentAreaBrush" Color="#FF29292B" />

    <!-- ==================== Surfaces ==================== -->
    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#FF2E2E31" />
    <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="#FF2B2B2E" />
    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#FF3A3A3E" />
    <SolidColorBrush x:Key="CardStrokeColorDefaultSolidBrush" Color="#FF3A3A3E" />

    <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#FF303034" />
    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#FF38383C" />
    <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="#FF2B2B2E" />
    <SolidColorBrush x:Key="ControlFillColorTransparentBrush" Color="#00FFFFFF" />
    <SolidColorBrush x:Key="ControlFillColorInputActiveBrush" Color="#FF1E1E21" />
    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#FF3C3C41" />
    <SolidColorBrush x:Key="ControlStrokeColorSecondaryBrush" Color="#FF333337" />
    <SolidColorBrush x:Key="ControlAltFillColorSecondaryBrush" Color="#FF2B2B2E" />
    <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="#FF2E2E32" />
    <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush" Color="#FF28282B" />

    <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="#FF1F1F22" />
    <SolidColorBrush x:Key="LayerFillColorAltBrush" Color="#FF1B1B1D" />
    <SolidColorBrush x:Key="LayerOnAcrylicFillColorDefaultBrush" Color="#FF1F1F22" />
    <SolidColorBrush x:Key="AcrylicBackgroundFillColorDefaultBrush" Color="#FF26262A" />
    <SolidColorBrush x:Key="AcrylicBackgroundFillColorBaseBrush" Color="#FF202023" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorTertiaryBrush" Color="#FF202023" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorQuarternaryBrush" Color="#FF26262A" />

    <!-- Dense text surfaces (the game output, the activity log): darker than a card. -->
    <SolidColorBrush x:Key="PanelDeepBrush" Color="#FF1E1E20" />

    <!-- Dialogs: an opaque card over a dimmed window, so nothing behind shows through. -->
    <SolidColorBrush x:Key="DialogScrimBrush" Color="#99000000" />
    <SolidColorBrush x:Key="DialogBackgroundBrush" Color="#FF2C2C2F" />
    <SolidColorBrush x:Key="DialogStrokeBrush" Color="#FF3E3E43" />

    <!-- Sidebar rows -->
    <SolidColorBrush x:Key="SidebarItemSelectedBrush" Color="#FF37373B" />
    <SolidColorBrush x:Key="SidebarItemHoverBrush" Color="#FF2E2E31" />
    <SolidColorBrush x:Key="SidebarHeaderBrush" Color="#FF67676D" />

    <!-- ==================== Text & accent ==================== -->
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#FFE6E6E8" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#FFB6B6BB" />
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#FF909096" />
    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#FF4C9DFF" />
    <SolidColorBrush x:Key="StatusDotIdleBrush" Color="#FF6E6E74" />
    <SolidColorBrush x:Key="WarningTextBrush" Color="#FFF2B84B" />
    <SolidColorBrush x:Key="DangerTextBrush" Color="#FFFF6B6B" />
    <SolidColorBrush x:Key="GoodTextBrush" Color="#FF5FD38A" />
    <!-- The chosen option of a segmented control and the active tab. -->
    <SolidColorBrush x:Key="SegmentSelectedBrush" Color="#FF2D7FF0" />

    <!-- Pane, divider and pill colours; Glass.xaml turns them into glass for the Modern layout. -->
    <SolidColorBrush x:Key="GlassPaneBrush" Color="#FF2E2E31" />
    <SolidColorBrush x:Key="GlassPaneStrokeBrush" Color="#FF3A3A3E" />
    <SolidColorBrush x:Key="GlassDividerBrush" Color="#FF3A3A3E" />
    <SolidColorBrush x:Key="PillTrackBrush" Color="#FF1E1E21" />

    <!-- ==================== Shape ==================== -->
    <CornerRadius x:Key="ControlCornerRadius">6</CornerRadius>
    <CornerRadius x:Key="OverlayCornerRadius">8</CornerRadius>

</ResourceDictionary>
