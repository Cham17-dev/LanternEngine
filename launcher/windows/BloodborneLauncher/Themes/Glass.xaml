<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Glass: the Modern layout's look. Frosted, translucent surfaces over a blurred, darkened
        backdrop of the game's own artwork. Merged over Charcoal.xaml at start (MainWindow), so it
        only overrides colours; every control keeps its template.
    -->

    <!-- Panes: white glass, brighter along the top edge where the light catches it. -->
    <SolidColorBrush x:Key="GlassPaneBrush" Color="#1CFFFFFF" />
    <LinearGradientBrush x:Key="GlassPaneStrokeBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#66FFFFFF" Offset="0" />
        <GradientStop Color="#1FFFFFFF" Offset="0.35" />
        <GradientStop Color="#14FFFFFF" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="GlassDividerBrush" Color="#16FFFFFF" />

    <!-- Pills: the tab strip and segmented controls; the chosen one is a brighter glass bead. -->
    <SolidColorBrush x:Key="PillTrackBrush" Color="#33000000" />
    <LinearGradientBrush x:Key="SegmentSelectedBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#70FFFFFF" Offset="0" />
        <GradientStop Color="#38FFFFFF" Offset="1" />
    </LinearGradientBrush>

    <!-- WPF-UI's own surfaces, made translucent so cards, buttons and fields read as glass. -->
    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#1CFFFFFF" />
    <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#26FFFFFF" />
    <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#22FFFFFF" />
    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#2EFFFFFF" />
    <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="#18FFFFFF" />
    <SolidColorBrush x:Key="ControlFillColorInputActiveBrush" Color="#40000000" />
    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#2AFFFFFF" />
    <SolidColorBrush x:Key="ControlStrokeColorSecondaryBrush" Color="#1AFFFFFF" />
    <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="#1AFFFFFF" />
    <SolidColorBrush x:Key="SidebarItemHoverBrush" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="ContentAreaBrush" Color="Transparent" />
    <SolidColorBrush x:Key="WindowBaseBrush" Color="#FF0C0D10" />
    <SolidColorBrush x:Key="PanelDeepBrush" Color="#66000000" />

    <!-- Dialogs stay opaque: glass over glass is unreadable. -->
    <SolidColorBrush x:Key="DialogScrimBrush" Color="#A6000000" />
    <LinearGradientBrush x:Key="DialogBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FF2A2D33" Offset="0" />
        <GradientStop Color="#FF1F2126" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="DialogStrokeBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#55FFFFFF" Offset="0" />
        <GradientStop Color="#1AFFFFFF" Offset="0.4" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#FFF5F6F8" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#FFC2C5CA" />
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#FF9A9DA3" />

</ResourceDictionary>
